{
  "extends": "@deephaven/tsconfig",
  "compilerOptions": {
    "emitDeclarationOnly": false,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@deephaven/js-plugin-pivot": ["plugins/pivot/src/js/src/index.ts"]
    }
  },
  "include": [
    "plugins/**/**.ts",
    "plugins/**/**.tsx",
    "plugins/**/**.js",
    "plugins/**/**.jsx",
    "tests/**/**.ts"
  ],
  "exclude": ["**/node_modules", "plugins/*/src/js/dist/**/*"],
  "watchOptions": {
    "excludeDirectories": ["**/node_modules", "**/dist"]
  }
}
